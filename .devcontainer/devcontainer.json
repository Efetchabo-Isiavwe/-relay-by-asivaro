{
  "name": "RELAY Cloud Lab",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "24.12.0"
    }
  },
  "postCreateCommand": "npm install --no-audit --no-fund",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ]
    }
  },
  "shutdownAction": "stopContainer",
  "waitFor": "postCreateCommand",
  "forwardPorts": [
    5173
  ],
  "portsAttributes": {
    "5173": {
      "label": "RELAY web preview",
      "onAutoForward": "openBrowser",
      "visibility": "private"
    }
  }
}

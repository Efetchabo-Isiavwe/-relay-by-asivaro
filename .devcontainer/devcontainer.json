{
  "name": "RELAY Cloud Lab",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-24-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/desktop-lite:1": {
      "password": "vscode",
      "webPort": "6080",
      "vncPort": "5901"
    }
  },
  "postCreateCommand": "npm install --no-audit --no-fund",
  "forwardPorts": [5173, 6080],
  "portsAttributes": {
    "5173": {
      "label": "RELAY web preview",
      "onAutoForward": "openBrowser",
      "visibility": "private"
    },
    "6080": {
      "label": "Private remote Chrome desktop (noVNC)",
      "visibility": "private"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ]
    }
  },
  "shutdownAction": "stopContainer",
  "waitFor": "postCreateCommand"
}

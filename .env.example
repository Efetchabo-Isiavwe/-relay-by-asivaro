# Copy this file to .env.local and add values from Firebase Console.
# Firebase Web config values are public client configuration, not server secrets.
VITE_FIREBASE_API_KEY=replace_me
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=replace_me
VITE_FIREBASE_APP_ID=replace_me

# For local development, leave this placeholder unchanged: RELAY uses the Firebase
# App Check debug-token flow. Production builds must configure a real attestation provider.
VITE_RECAPTCHA_V3_SITE_KEY=replace_with_site_key

# Stable cloud fallback model configured via Firebase AI Logic.
VITE_CLOUD_FALLBACK_MODEL=gemini-4-hydrogen
